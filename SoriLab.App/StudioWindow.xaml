<Window x:Class="SoriLab.App.StudioWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SoriLab.App"
 Title="소리공방 · 효과음 작업실" Width="1420" Height="940" MinWidth="1180" MinHeight="800"
 Background="#11141C" Foreground="#F1F3F8" FontFamily="Malgun Gothic" FontSize="12"
 WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnFileDrop">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#293044"/><Setter Property="Foreground" Value="#EAEFF8"/><Setter Property="Padding" Value="13,9"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".35"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value=".8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#111722"/><Setter Property="Foreground" Value="#EAF0FA"/><Setter Property="BorderBrush" Value="#39465D"/><Setter Property="Padding" Value="8,6"/><Setter Property="CaretBrush" Value="#BBA8FB"/></Style>
  <Style TargetType="TextBlock" x:Key="Caption"><Setter Property="Foreground" Value="#93A1B9"/><Setter Property="FontSize" Value="11"/></Style>
  <Style TargetType="Slider"><Setter Property="Margin" Value="0,6,0,0"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#CAD4E7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid Margin="24,20,24,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal"><Border Background="#8068DB" CornerRadius="9" Width="38" Height="38" Margin="0,0,12,0"><TextBlock Text="≋" FontSize="29" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><StackPanel><TextBlock Text="소리공방" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="ProjectName" Text="새 프로젝트" Style="{StaticResource Caption}"/></StackPanel></StackPanel>
   <StackPanel Grid.Column="1" x:Name="FileCommands" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="새 작업" Click="OnNew" Margin="0,0,6,0"/><Button Content="프로젝트 열기" Click="OnOpenProject" Margin="0,0,6,0"/><Button Content="저장" Click="OnSaveProject" Margin="0,0,6,0" ToolTip="Ctrl+S · 원본과 편집 설정을 함께 저장"/><Button Content="다른 이름 저장" Click="OnSaveProjectAs" Margin="0,0,12,0"/><Button x:Name="ExportButton" Content="WAV 내보내기  ↗" Background="#8C75E8" Click="OnExport"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="0,22,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="소리를 겹치고, 나만의 효과음으로." FontSize="23" FontWeight="Bold"/><TextBlock Text="여러 트랙에 클립을 배치하세요. 클릭으로 분할 위치 지정 · 드래그로 이동" Foreground="#93A1B9" Margin="0,6,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" x:Name="AddCommands"><Button Content="＋ 새 트랙" Click="OnAddFiles" Background="#2C3E42" Foreground="#B8F1E4" Margin="0,0,8,0"/><Button x:Name="AddToTrackButton" Content="클립 추가" Click="OnAddToTrack" Margin="0,0,8,0" ToolTip="선택한 트랙의 편집 커서 위치에 WAV 추가"/><Button Content="✦ 소리 생성" Click="OnGenerate" Background="#342D49" Foreground="#D5C2FF"/></StackPanel>
  </Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="282"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="180"/><RowDefinition Height="Auto"/><RowDefinition Height="170"/></Grid.RowDefinitions>
    <Border Background="#1C2332" CornerRadius="10,10,0,0" Padding="14,10"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="TrackSummary" Text="타임라인 · 소리를 추가하세요" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" x:Name="TrackCommands" Orientation="Horizontal"><CheckBox x:Name="MuteCheck" Content="트랙 음소거" Checked="OnTrackSwitch" Unchecked="OnTrackSwitch" Margin="0,0,13,0"/><CheckBox x:Name="SoloCheck" Content="단독 듣기" Checked="OnTrackSwitch" Unchecked="OnTrackSwitch" Margin="0,0,13,0"/><Button Content="클립 복제" Click="OnDuplicate" Padding="9,5" Margin="0,0,6,0"/><Button Content="클립 제거" Click="OnRemove" Padding="9,5"/></StackPanel></Grid>
     <Grid x:Name="ArrangementCommands" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><TextBlock Text="편집 커서" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBox x:Name="CursorInput" Text="0" Width="76" Padding="6,4" LostKeyboardFocus="OnCursorCommitted" KeyDown="OnCursorKeyDown"/><TextBlock Text="초" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="5,0,10,0"/><Button x:Name="SplitButton" Content="분할 (S)" Click="OnSplit" Padding="10,5" ToolTip="현재 효과를 소리에 반영한 뒤 커서에서 나눕니다. 원본 파일은 보존하며 실행 취소할 수 있습니다."/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock x:Name="ZoomText" Text="100%" Foreground="#A9B5CB" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Content="−" Click="OnZoomOut" Padding="10,5"/><Button Content="＋" Click="OnZoomIn" Padding="10,5" Margin="4,0,4,0"/><Button Content="전체 보기" Click="OnZoomFit" Padding="9,5"/></StackPanel>
     </Grid>
    </StackPanel></Border>
    <Border Grid.Row="1" Background="#141B27" BorderBrush="#2A3447" BorderThickness="1,0,1,1" CornerRadius="0,0,10,10"><Grid><ScrollViewer x:Name="TimelineScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"><local:TrackTimelineView x:Name="Timeline"/></ScrollViewer><TextBlock x:Name="TimelineEmpty" Text="WAV 파일을 끌어 놓거나, 소리 생성으로 시작하세요." Foreground="#95A4BD" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid></Border>
    <Grid Grid.Row="2" Margin="1,17,1,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SourceLabel" Text="선택한 클립의 원본 구간" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="드래그: 사용할 구간 선택" Style="{StaticResource Caption}"/></Grid>
    <Border Grid.Row="3" CornerRadius="10" Background="#141B27"><local:WaveformView x:Name="SourceWaveform" Margin="4"/></Border>
   </Grid>
   <Border Grid.Column="2" Background="#1A2130" CornerRadius="10" Padding="17,15"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Padding="0,0,7,0"><StackPanel x:Name="Inspector">
    <TextBlock x:Name="SelectedName" Text="클립을 선택하세요" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SelectedInfo" Text="원본을 보존하며 편집합니다." Style="{StaticResource Caption}" Margin="0,5,0,12"/>
    <TextBlock Text="배치 위치 · 초" Style="{StaticResource Caption}"/><TextBox x:Name="OffsetInput" Text="0.000" Margin="0,5,0,10" LostKeyboardFocus="OnNumbersCommitted" KeyDown="OnNumberKeyDown"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="원본 시작 · 초" Style="{StaticResource Caption}"/><TextBox x:Name="StartInput" Margin="0,5,0,0" LostKeyboardFocus="OnNumbersCommitted" KeyDown="OnNumberKeyDown"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="원본 끝 · 초" Style="{StaticResource Caption}"/><TextBox x:Name="EndInput" Margin="0,5,0,0" LostKeyboardFocus="OnNumbersCommitted" KeyDown="OnNumberKeyDown"/></StackPanel></Grid>
    <Button Content="원본 전체 구간" Click="OnSelectAll" Margin="0,8,0,14" Padding="10,7"/>
    <Grid><TextBlock Text="클립 음량"/><TextBlock x:Name="GainValue" HorizontalAlignment="Right" Foreground="#BCA9FC"/></Grid><Slider x:Name="GainSlider" Minimum="-24" Maximum="12" TickFrequency=".5" IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged"/>
    <Grid Margin="0,12,0,0"><TextBlock Text="페이드 인"/><TextBlock x:Name="FadeInValue" HorizontalAlignment="Right" Foreground="#BCA9FC"/></Grid><Slider x:Name="FadeInSlider" Minimum="0" Maximum="1000" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged"/>
    <Grid Margin="0,12,0,0"><TextBlock Text="페이드 아웃"/><TextBlock x:Name="FadeOutValue" HorizontalAlignment="Right" Foreground="#BCA9FC"/></Grid><Slider x:Name="FadeOutSlider" Minimum="0" Maximum="1000" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged"/>
    <Border Height="1" Background="#344057" Margin="0,16,0,13"/>
    <Grid><TextBlock Text="재생 속도"/><TextBlock x:Name="RateValue" HorizontalAlignment="Right" Foreground="#BCA9FC"/></Grid><Slider x:Name="RateSlider" Minimum=".25" Maximum="4" Value="1" TickFrequency=".05" IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged"/><TextBlock x:Name="PitchInfo" Text="속도와 음높이가 함께 바뀝니다." Style="{StaticResource Caption}" Margin="0,3,0,9"/>
    <CheckBox x:Name="ReverseCheck" Content="역재생" Checked="OnTrackSwitch" Unchecked="OnTrackSwitch"/>
    <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="UndoButton" Content="↶ 실행 취소" Click="OnUndo" Padding="8,8"/><Button x:Name="RedoButton" Grid.Column="2" Content="↷ 다시 실행" Click="OnRedo" Padding="8,8"/></Grid>
    <Button Content="선택 클립 편집 초기화" Click="OnReset" Background="Transparent" Foreground="#A7B5CE" Padding="6,9" Margin="0,3,0,0"/>
   </StackPanel></ScrollViewer></Border>
  </Grid>
  <Border Grid.Row="3" Background="#1C2432" CornerRadius="10" Padding="16,12" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="235"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="PlayButton" Content="▶ 전체 재생" Click="OnPlay" Background="#B8F1DD" Foreground="#163D33" Width="115"/><Button Content="■" Click="OnStop" Margin="7,0,14,0" Width="38" Padding="0"/><StackPanel><TextBlock x:Name="PositionText" Text="00:00.000" FontSize="20" FontFamily="Consolas"/><TextBlock x:Name="DurationText" Text="전체 0.000초" Style="{StaticResource Caption}"/></StackPanel></StackPanel>
   <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"><CheckBox x:Name="LoopCheck" Content="반복 재생"/><CheckBox x:Name="SelectedOnlyCheck" Content="선택 클립만 듣기" Margin="0,7,0,0" Checked="OnListeningChanged" Unchecked="OnListeningChanged"/></StackPanel>
   <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,25,0"><TextBlock Text="출력 최대 음량" Style="{StaticResource Caption}"/><TextBlock x:Name="PeakText" Text="—" Foreground="#B8F1DD" FontSize="19" Margin="0,3,0,0"/></StackPanel>
   <StackPanel Grid.Column="3" VerticalAlignment="Center"><Grid><TextBlock Text="전체 음량" Style="{StaticResource Caption}"/><TextBlock x:Name="MasterValue" Text="0.0 dB" HorizontalAlignment="Right" Foreground="#BCA9FC"/></Grid><Slider x:Name="MasterSlider" Minimum="-24" Maximum="0" TickFrequency=".5" IsSnapToTickEnabled="True" ValueChanged="OnMasterChanged"/><CheckBox x:Name="BypassCheck" Content="음량·페이드 없이 비교" Checked="OnListeningChanged" Unchecked="OnListeningChanged" Margin="0,4,0,0"/></StackPanel>
  </Grid></Border>
  <TextBlock Grid.Row="4" x:Name="StatusText" Text="준비됨 · WAV를 추가하거나 새 소리를 생성하세요." Foreground="#A6B5CD" Margin="1,13,0,0" TextWrapping="Wrap"/>
 </Grid>
</Window>
