<Window x:Class="SoriLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SoriLab.App"
        Title="소리공방 · 게임 사운드 편집" Width="1280" Height="850" MinWidth="1040" MinHeight="740"
        WindowStartupLocation="CenterScreen" Background="#11141C" Foreground="#F1F3F8"
        FontFamily="Malgun Gothic" FontSize="13" AllowDrop="True" Drop="OnFileDrop">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#909BB1" />
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EBEDF5"/><Setter Property="Background" Value="#272D3E"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="17,11"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#10141E"/><Setter Property="Foreground" Value="#ECF0FA"/>
            <Setter Property="BorderBrush" Value="#394359"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,9"/><Setter Property="CaretBrush" Value="#B3A0FF"/>
            <Setter Property="SelectionBrush" Value="#6E54BD"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Slider"><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="1000"/><Setter Property="Margin" Value="0,7,0,0"/></Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Grid Background="#1A1F2C"><Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Background="#465069"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="4"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                </Track></Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#C5CDDE"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/></Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#CCD4E5"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    </Window.Resources>
    <Grid Margin="28,22,28,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#7760D9" Width="38" Height="38" CornerRadius="11" Margin="0,0,12,0"><TextBlock Text="≋" FontSize="29" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/></Border>
                <StackPanel><TextBlock Text="소리공방" FontWeight="Bold" FontSize="21"/><TextBlock Text="게임 사운드 편집" Style="{StaticResource Caption}"/></StackPanel>
                <Border Background="#242335" CornerRadius="6" Padding="9,5" Margin="17,0,0,0" VerticalAlignment="Center"><TextBlock Text="첫 번째 검수본" Foreground="#B5A4EF" FontSize="11"/></Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="OpenButton" Content="WAV 불러오기" Click="OnOpen" ToolTip="Ctrl+O · WAV 파일을 이 창에 끌어 놓아도 됩니다." Margin="0,0,10,0"/>
                <Button x:Name="ExportButton" Content="WAV 내보내기  ↗" Background="#8C75E8" Foreground="#FFFFFF" Click="OnExport" IsEnabled="False" ToolTip="Ctrl+Shift+S · 선택 구간을 16비트 WAV로 저장합니다."/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,28,0,22">
            <TextBlock Text="소리의 필요한 순간을 남기세요." FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="구간을 선택하고, 소리의 크기와 시작·끝을 다듬어 보세요." Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="286"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="#1B2030" CornerRadius="12,12,0,0" Padding="18,15">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock x:Name="FileNameText" Text="아직 불러온 소리가 없어요" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="FileInfoText" Text="모노 또는 스테레오 WAV 파일을 열어 주세요." Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
                        <TextBlock Grid.Column="1" x:Name="FileBadge" Text="원본 · WAV" Foreground="#62CFC0" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Background="#141923" BorderBrush="#293145" BorderThickness="1,0,1,1" CornerRadius="0,0,12,12" ClipToBounds="True">
                    <Grid><local:WaveformView x:Name="Waveform" Margin="10,8,10,8"/>
                        <StackPanel x:Name="EmptyOverlay" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,22,0,0">
                            <TextBlock Text="파일 하나에서 시작하세요" HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="WAV 파일을 이곳으로 끌어 놓거나 불러오기를 눌러 주세요." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}" MaxWidth="330" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="2" Margin="0,17,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PlayButton" Content="▶  재생" Width="108" Background="#C2F4E2" Foreground="#173D37" Click="OnPlay" IsEnabled="False" ToolTip="Space · 재생 / 일시정지"/>
                        <Button x:Name="StopButton" Content="■" Width="42" Padding="0" Margin="8,0,0,0" Click="OnStop" IsEnabled="False" ToolTip="정지하고 선택 구간의 처음으로 이동"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="PositionText" Text="00:00.000" FontFamily="Consolas" FontSize="21" HorizontalAlignment="Center"/><TextBlock x:Name="PlaybackInfoText" Text="선택 구간 미리 듣기" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center"><CheckBox x:Name="LoopCheck" Content="반복 재생"/><CheckBox x:Name="BypassCheck" Content="효과 없이 듣기" Margin="0,9,0,0" Checked="OnBypassChanged" Unchecked="OnBypassChanged" ToolTip="같은 선택 구간을 음량·페이드 적용 없이 듣습니다."/></StackPanel>
                </Grid>
                <Border Grid.Row="3" Background="#1A202C" CornerRadius="10" Padding="17,14" Margin="0,19,0,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="선택 길이" Style="{StaticResource Caption}"/><TextBlock x:Name="SelectionLengthText" Text="—" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="편집 후 최대 음량" Style="{StaticResource Caption}"/><TextBlock x:Name="PeakText" Text="—" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="내보내기" Style="{StaticResource Caption}"/><TextBlock Text="WAV · 16비트" FontSize="16" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Column="2" Background="#1A1F2C" CornerRadius="12" Padding="20,20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Padding="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="선택 구간 편집" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="원본 파일은 그대로 보존됩니다." Style="{StaticResource Caption}" Margin="0,7,0,0"/>
                        <StackPanel x:Name="EditPanel" IsEnabled="False">
                            <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="시작 · 초" Style="{StaticResource Caption}"/><TextBox x:Name="StartInput" Text="0.000" Margin="0,7,0,0" LostKeyboardFocus="OnTimeCommitted" KeyDown="OnTimeKeyDown"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="끝 · 초" Style="{StaticResource Caption}"/><TextBox x:Name="EndInput" Text="0.000" Margin="0,7,0,0" LostKeyboardFocus="OnTimeCommitted" KeyDown="OnTimeKeyDown"/></StackPanel>
                            </Grid>
                            <Button Content="전체 구간 선택" Click="OnSelectAll" Margin="0,10,0,0" Padding="12,9" Background="#292D40"/>
                            <Border Height="1" Background="#2C3345" Margin="0,15,0,15"/>
                            <Grid><TextBlock Text="음량" Style="{StaticResource SectionLabel}"/><TextBlock x:Name="GainValue" Text="0.0 dB" Foreground="#BBA8FB" HorizontalAlignment="Right"/></Grid>
                            <Slider x:Name="GainSlider" Minimum="-24" Maximum="12" Value="0" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged"/>
                            <Grid Margin="0,2,0,0"><TextBlock Text="−24 dB" Style="{StaticResource Caption}"/><TextBlock Text="+12 dB" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></Grid>
                            <Grid Margin="0,15,0,0"><TextBlock Text="페이드 인" Style="{StaticResource SectionLabel}"/><TextBlock x:Name="FadeInValue" Text="0 ms" Foreground="#BBA8FB" HorizontalAlignment="Right"/></Grid>
                            <TextBlock Text="시작을 서서히 크게" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                            <Slider x:Name="FadeInSlider" ValueChanged="OnSliderChanged" TickFrequency="5" IsSnapToTickEnabled="True"/>
                            <Grid Margin="0,14,0,0"><TextBlock Text="페이드 아웃" Style="{StaticResource SectionLabel}"/><TextBlock x:Name="FadeOutValue" Text="0 ms" Foreground="#BBA8FB" HorizontalAlignment="Right"/></Grid>
                            <TextBlock Text="끝을 서서히 작게" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                            <Slider x:Name="FadeOutSlider" ValueChanged="OnSliderChanged" TickFrequency="5" IsSnapToTickEnabled="True"/>
                            <Border Height="1" Background="#2C3345" Margin="0,15,0,12"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button x:Name="UndoButton" Content="↶  실행 취소" Click="OnUndo" Padding="8,10" ToolTip="Ctrl+Z"/>
                                <Button Grid.Column="2" x:Name="RedoButton" Content="↷  다시 실행" Click="OnRedo" Padding="8,10" ToolTip="Ctrl+Y"/>
                            </Grid>
                            <Button Content="편집 초기화" Click="OnReset" Margin="0,8,0,0" Background="Transparent" Foreground="#A5AFC4" Padding="8,9"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="준비됨 · WAV 파일을 불러와 시작하세요." Foreground="#A8B3C9" TextWrapping="Wrap" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="드래그: 구간 선택  ·  Space: 재생" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
